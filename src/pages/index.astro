<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>Redirigiendo…</title>
    <script is:inline>
      const saved = localStorage.getItem('lang');
      const defaultLang = navigator.language.startsWith('en') ? 'en' : 'es';
      const lang = saved || defaultLang;
      window.location.replace(`/${lang}/`);
    </script>
  </head>
  <body></body>
</html>
